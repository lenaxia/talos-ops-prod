# ----------------------------------------------------------------------------
# sops secret TEMPLATE for the trading functions — NEVER commit real values.
#
# TWO files total. Copy + fill + encrypt with the repo's age key, e.g.:
#   sops --encrypt --in-place clusters/tradingpg-app.sops.yaml
#   sops --encrypt --in-place functions/trading/secret-trading.sops.yaml
#
# talos-ops-prod landing spots (GitOps):
#   kubernetes/apps/databases/cloudnative-pg/clusters/tradingpg-app.sops.yaml
#       -> CNPG bootstrap.initdb.secret: username + password only (the
#          operator creates role `trading` + database `trading` at first
#          boot; uncomment its entry in clusters/kustomization.yaml)
#   kubernetes/apps/fission/fission/functions/trading/secret-trading.sops.yaml
#       -> ONE shared secret mounted by all 8 functions at
#          /secrets/fission/trading/<KEY>; uncomment it in
#          functions/trading/kustomization.yaml
#
# Shared key set (functions read only the keys they use; env fallback
# covers anything absent):
#   PGHOST=tradingpg-rw.databases.svc.cluster.local PGPORT=5432
#   PGDATABASE=trading PGUSER=trading
#   PGPASSWORD=<the tradingpg-app password>
#   LLM_API_BASE LLM_API_KEY LLM_MODEL   (debate only reads these)
#   ALPACA_PAPER_API_KEY ALPACA_PAPER_API_SECRET
#   ALPACA_PAPER_API_ENDPOINT            (execute only reads these)
#   PILOT_NOTIONAL                       (execute, e.g. "135000")
#   GITHUB_TOKEN                         (debate/decide/score/digest/seed)
#   SHADOW="1" during the comparison week (execute is paper-read-only);
#     flip to 0 at cutover — one key flips every function.
# ----------------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
    name: tradingpg-app
    namespace: databases
type: kubernetes.io/basic-auth
stringData:
    username: trading
    password: REPLACE_WITH_GENERATED_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
    name: trading
    namespace: fission
stringData:
    PGHOST: tradingpg-rw.databases.svc.cluster.local
    PGPORT: "5432"
    PGDATABASE: trading
    PGUSER: trading
    PGPASSWORD: REPLACE_WITH_GENERATED_PASSWORD
    LLM_API_BASE: REPLACE
    LLM_API_KEY: REPLACE
    LLM_MODEL: REPLACE
    ALPACA_PAPER_API_KEY: REPLACE
    ALPACA_PAPER_API_SECRET: REPLACE
    ALPACA_PAPER_API_ENDPOINT: https://paper-api.alpaca.markets
    PILOT_NOTIONAL: "135000"
    GITHUB_TOKEN: REPLACE
    SHADOW: "1"
type: Opaque
