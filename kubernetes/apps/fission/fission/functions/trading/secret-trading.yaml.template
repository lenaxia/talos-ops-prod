# ----------------------------------------------------------------------------
# sops secret TEMPLATE for the trading functions — NEVER commit real values.
#
# Copy to the two files below and encrypt with the repo's age key, e.g.:
#   sops --encrypt --in-place tradingpg-app.sops.yaml
#   sops --encrypt --in-place secret-<function>.sops.yaml   (per function)
#
# talos-ops-prod landing spots (GitOps):
#   kubernetes/apps/databases/cloudnative-pg/clusters/tradingpg-app.sops.yaml
#       -> only the PASSWORD key (role credential for the trading DB;
#          uncomment its entry in clusters/kustomization.yaml alongside
#          the db-init Job)
#   kubernetes/apps/fission/fission/functions/trading/secret-<function>.sops.yaml
#       -> per-function keys, see the matrix in README-TRADING.md
#
# Key matrix (per function secret, least privilege):
#
#   function         keys
#   ---------------  ------------------------------------------------------
#   debate           PGHOST PGPORT PGDATABASE PGUSER PGPASSWORD
#                    LLM_API_BASE LLM_API_KEY LLM_MODEL
#                    GITHUB_TOKEN SHADOW
#   decide           PG*  GITHUB_TOKEN SHADOW
#   execute          PG*  ALPACA_PAPER_API_KEY ALPACA_PAPER_API_SECRET
#                    ALPACA_PAPER_API_ENDPOINT PILOT_NOTIONAL SHADOW
#   score            PG*  GITHUB_TOKEN SHADOW
#   digest           PG*  GITHUB_TOKEN SHADOW
#   morning-chain    PG*  FISSION_ROUTER_URL
#   afternoon-chain  PG*  FISSION_ROUTER_URL
#   trading-seed     PG*  GITHUB_TOKEN
#
# PG* values (all functions): PGHOST=tradingpg-rw.databases.svc.cluster.local
#   PGPORT=5432 PGDATABASE=trading PGUSER=trading
#   PGPASSWORD=<the tradingpg-app PASSWORD>
# SHADOW=1 during the comparison week (execute is paper-read-only);
#   flip to 0 at cutover. FISSION_ROUTER_URL defaults to
#   http://router.fission.svc.cluster.local (only set to override).
# ----------------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
    name: tradingpg-app
    namespace: databases
stringData:
    PASSWORD: REPLACE_WITH_GENERATED_PASSWORD
type: Opaque
---
apiVersion: v1
kind: Secret
metadata:
    name: trading-FUNCTIONNAME
    namespace: fission
stringData:
    # PGHOST: tradingpg-rw.databases.svc.cluster.local
    # PGPORT: "5432"
    # PGDATABASE: trading
    # PGUSER: trading
    # PGPASSWORD: REPLACE
    # LLM_API_BASE / LLM_API_KEY / LLM_MODEL: debate only
    # ALPACA_PAPER_API_KEY / _SECRET / _ENDPOINT: execute only
    # GITHUB_TOKEN: debate/decide/score/digest/trading-seed
    # PILOT_NOTIONAL: execute only (e.g. "135000")
    # SHADOW: "1"
    EXAMPLE_KEY: REPLACE_OR_DELETE
type: Opaque
